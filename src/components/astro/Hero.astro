---
/* Hero.astro
   The page opens as a drafting sheet: a ruled frame with corner crop
   marks, the name set large in the display face, and the role line
   cycling by select-all-and-paste rather than the usual typewriter
   backspace.

   The role list is handed to the script through a data attribute
   rather than imported: the script is bundled once for the whole
   site, so it cannot know which language rendered the page.     */

import { getLang, localizePath, pick, stripLang, useTranslations } from "../../i18n";
import { site } from "../../config";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const person = pick(site, lang);

const isHome = stripLang(Astro.url.pathname) === "/";
const aboutHref = isHome ? "#about" : `${localizePath("/", lang)}#about`;
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden px-6"
>
  <div class="absolute inset-0 pointer-events-none blueprint-grid z-0 opacity-70"></div>
  <div class="noise absolute inset-0 pointer-events-none z-0"></div>

  <!-- Sheet frame with crop marks at each corner. Insets live in the
       style block rather than in utilities because the top one is not a
       spacing step — see .hero-frame. -->
  <div
    data-parallax-frame
    class="hero-frame absolute pointer-events-none z-0"
    aria-hidden="true"
  >
    <span class="crop crop-tl"></span>
    <span class="crop crop-tr"></span>
    <span class="crop crop-bl"></span>
    <span class="crop crop-br"></span>
  </div>

  <!-- Border annotations. A drawing states its status and origin in the
       margin, and those are the two facts a visitor hiring for a role
       wants before scrolling — so the frame carries information rather
       than enclosing a void. -->
  <div class="hero-margin">
    <p class="hero-note hero-note-status">
      <span class="hero-dot" aria-hidden="true"></span>{person.status}
    </p>
    <p class="hero-note hero-note-place">{site.location}</p>
  </div>

  <div data-parallax-text class="relative z-10 text-center">
    <!-- Name and first role are rendered server-side; the script below
         re-splits and retypes them. Without JS the hero still reads. -->
    <h1 class="type-hero mb-6">
      <span class="hero-name">{site.author}</span>
    </h1>

    <p class="font-mono text-base md:text-lg text-accent-primary h-8 flex items-center justify-center gap-1">
      <span id="typewriter" data-roles={JSON.stringify(person.roles)}>{person.roles[0]}</span>
      <span id="cursor" class="animate-pulse" hidden>|</span>
    </p>

    <p class="mt-8 text-text-muted max-w-md mx-auto leading-relaxed hero-thesis">
      {person.thesis}
    </p>
  </div>

  <a
    href={aboutHref}
    class="group absolute bottom-10 z-10 flex flex-col items-center gap-2 text-text-muted hover:text-accent-primary transition-colors"
    aria-label={t.hero.scrollAria}
  >
    <span class="eyebrow">{t.hero.scroll}</span>
    <span class="scroll-tick" aria-hidden="true"></span>
  </a>
</section>

<style>
  /* ── Sheet frame ─────────────────────────────────
     The bar above is transparent over the hero, which is the only
     reason the top edge and the two upper crop marks are visible at
     all. Its *content* still occupies that band, though: at the old
     1.5rem the edge ruled a line along the nav links' baseline and
     the top-left crop mark was struck through the navbar's mark. So the
     sheet starts where the chrome ends — top is --nav-h, not a
     spacing step, and the edge lands flush under the bar. Sides and
     bottom keep the original insets. */
  .hero-frame {
    top: var(--nav-h, 65px);
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    border: 1px solid var(--border-faint);
  }
  @media (min-width: 768px) {
    .hero-frame {
      right: 2.5rem;
      bottom: 2.5rem;
      left: 2.5rem;
    }
  }
  .crop {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent-primary);
    opacity: 0.55;
  }
  /* Width and style only, never the `border-top: 1px solid` shorthand: the
     shorthand resets border-*-color to currentColor, and these rules come
     after .crop at equal specificity — so the accent above was silently
     overwritten and the marks painted as dimmed body text instead. */
  .crop-tl { top: -1px; left: -1px; border-top-width: 1px; border-top-style: solid; border-left-width: 1px; border-left-style: solid; }
  .crop-tr { top: -1px; right: -1px; border-top-width: 1px; border-top-style: solid; border-right-width: 1px; border-right-style: solid; }
  .crop-bl { bottom: -1px; left: -1px; border-bottom-width: 1px; border-bottom-style: solid; border-left-width: 1px; border-left-style: solid; }
  .crop-br { bottom: -1px; right: -1px; border-bottom-width: 1px; border-bottom-style: solid; border-right-width: 1px; border-right-style: solid; }

  /* ── Border annotations ────────────────────────────
     Pinned to the same inset as the sheet frame, so they read as
     writing in the margin rather than as floating labels. The
     centred scroll cue owns the middle of that edge, so the place
     note stands down below 768px instead of crowding it — it is
     also in the footer's title block, where nothing is lost. */
  .hero-margin {
    position: absolute;
    inset: 1.5rem;
    z-index: 10;
    pointer-events: none;
  }
  .hero-note {
    position: absolute;
    bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .hero-note-status {
    left: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-primary);
  }
  .hero-note-place { right: 0.5rem; display: none; }
  .hero-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
  }
  @media (min-width: 768px) {
    .hero-margin { inset: 2.5rem; }
    .hero-note-place { display: block; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-dot { animation: heroDot 2s ease-in-out infinite; }
    @keyframes heroDot {
      0%, 100% { opacity: 1; }
      50%      { opacity: 0.35; }
    }
  }

  /* ── Name reveal ───────────────────────────────── */
  .hero-letter {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
    animation: letterReveal 0.5s var(--ease-out-expo) forwards;
  }
  .hero-space {
    display: inline-block;
    width: 0.28em;
  }
  @keyframes letterReveal {
    to { opacity: 1; transform: translateY(0); }
  }

  /* The role swap reads as select-all then paste */
  .text-selected {
    background-color: var(--accent-primary);
    color: var(--text-on-accent);
    padding: 0 4px;
    border-radius: var(--radius-chip);
  }

  /* ── Scroll tick ───────────────────────────────── */
  .scroll-tick {
    display: block;
    width: 1px;
    height: 34px;
    background: linear-gradient(to bottom, currentColor, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The thesis line's entrance belongs to the hero timeline in
       scripts/motion/hero.ts — nothing here may hide it. */
    .scroll-tick {
      transform-origin: top;
      animation: tickDraw 2.4s var(--ease-out-expo) infinite;
    }
    @keyframes tickDraw {
      0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
      50%      { transform: scaleY(1);   opacity: 1; }
    }
  }
</style>

<script>
  import { onPageLoad, prefersReducedMotion } from "../../scripts/lifecycle";
  import { site } from "../../config";

  const NAME = site.author;
  const HIGHLIGHT_MS = 1500;

  onPageLoad((scope) => {
    const container = document.querySelector(".hero-name");
    const el = document.getElementById("typewriter");
    const cursor = document.getElementById("cursor");
    if (!container) return;

    const reduced = prefersReducedMotion();

    // Reduced motion keeps the server-rendered hero exactly as it is
    if (reduced) return;

    // --- Staggered letter reveal: re-split the rendered name ---
    container.textContent = "";
    NAME.split("").forEach((char, i) => {
      const span = document.createElement("span");
      if (char === " ") {
        span.className = "hero-space";
      } else {
        span.className = "hero-letter";
        span.style.animationDelay = `${0.3 + i * 0.05}s`;
      }
      span.textContent = char;
      container.appendChild(span);
    });

    // --- Role cycling: type the first, then select-all / paste the rest ---
    if (!el) return;

    // The roles are rendered into the page, so they are in the page's
    // language; a bundled script cannot know which that is.
    let roles: string[];
    try {
      roles = JSON.parse(el.dataset.roles || "[]");
    } catch {
      roles = [];
    }
    if (roles.length === 0) return;

    el.textContent = "";
    if (cursor) cursor.hidden = false;

    let roleIdx = 0;

    const startCycle = () => {
      scope.interval(() => {
        el.classList.add("text-selected");
        scope.timeout(() => {
          roleIdx = (roleIdx + 1) % roles.length;
          el.textContent = roles[roleIdx];
          el.classList.remove("text-selected");
        }, HIGHLIGHT_MS);
      }, 2500);
    };

    const typeFirstRole = () => {
      let charIdx = 0;
      const typeChar = () => {
        el.textContent = roles[0].slice(0, ++charIdx);
        if (charIdx < roles[0].length) {
          scope.timeout(typeChar, 50);
        } else {
          if (cursor) cursor.hidden = true;
          scope.timeout(startCycle, 1000);
        }
      };
      typeChar();
    };

    // Start typing once the name reveal has finished
    scope.timeout(typeFirstRole, 1200);
  });
</script>
